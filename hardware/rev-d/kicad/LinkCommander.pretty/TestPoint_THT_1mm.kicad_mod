(footprint "TestPoint_THT_1mm" (version 20211014) (generator pcbnew)
 (layer "F.Cu") (attr through_hole)
 (descr "Bare plated test hole, 2 mm copper diameter, 1 mm drill. Optional single THT pin; no extra part required.")
 (fp_text reference "REF**" (at 0 -2) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
 (fp_text value "TEST" (at 0 2) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
 (fp_circle (center 0 0) (end 1.1 0) (layer "F.Fab") (width 0.1))
 (fp_rect (start -1.25 -1.25) (end 1.25 1.25) (layer "F.CrtYd") (width 0.05))
 (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers *.Cu *.Mask))
)
